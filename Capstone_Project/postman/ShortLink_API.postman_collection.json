{
  "info": {
    "_postman_id": "shortlink-bitly-clone-api-2026",
    "name": "ShortLink – Bitly Clone REST API",
    "description": "Complete REST API collection for Web Dev III Capstone Project 10 (ShortLink Bitly Clone). Includes Auth (JWT Access + Refresh tokens), Protected Link CRUD, Aggregation-based Analytics, Redirect & Clicks tracking, and RBAC Admin routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleLinkId",
      "value": "",
      "type": "string"
    },
    {
      "key": "sampleShortCode",
      "value": "github-dev",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Developer\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Supervisor\",\n  \"email\": \"admin@shortlink.internal\",\n  \"password\": \"adminSecure2026\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', res.accessToken);",
                  "}",
                  "if (res.refreshToken) {",
                  "    pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('adminAccessToken', res.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@shortlink.internal\",\n  \"password\": \"adminSecure2026\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', res.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Links (Protected CRUD)",
      "item": [
        {
          "name": "Create Short Link (Auto Crypto Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.link) {",
                  "    pm.collectionVariables.set('sampleLinkId', res.link._id);",
                  "    pm.collectionVariables.set('sampleShortCode', res.link.shortCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://github.com/features/actions\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/links",
              "host": ["{{baseUrl}}"],
              "path": ["api", "links"]
            }
          }
        },
        {
          "name": "Create Short Link (Custom Alias & Expiry)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalUrl\": \"https://developer.mozilla.org/en-US/docs/Web/JavaScript\",\n  \"alias\": \"mdn-js-docs\",\n  \"expiresAt\": \"2027-12-31T23:59:59.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/links",
              "host": ["{{baseUrl}}"],
              "path": ["api", "links"]
            }
          }
        },
        {
          "name": "Get User Links",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/links?search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "links"],
              "query": [
                {
                  "key": "search",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Get Link by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/links/{{sampleLinkId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "links", "{{sampleLinkId}}"]
            }
          }
        },
        {
          "name": "Delete Link",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/links/{{sampleLinkId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "links", "{{sampleLinkId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Analytics (Aggregation Pipeline)",
      "item": [
        {
          "name": "Get Link Analytics (By Day & Device)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/links/{{sampleLinkId}}/analytics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "links", "{{sampleLinkId}}", "analytics"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Redirection & Click Counting",
      "item": [
        {
          "name": "Redirect Short Link (Simulate Browser Click)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{sampleShortCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{sampleShortCode}}"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Admin Management (RBAC)",
      "item": [
        {
          "name": "Get All Platform Links (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/links?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "links"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "Block Abusive Link (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBlocked\": true,\n  \"blockReason\": \"Phishing or malicious content detected\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/links/{{sampleLinkId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "links", "{{sampleLinkId}}", "status"]
            }
          }
        },
        {
          "name": "Unblock Link (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBlocked\": false,\n  \"blockReason\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/links/{{sampleLinkId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "links", "{{sampleLinkId}}", "status"]
            }
          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            }
          }
        },
        {
          "name": "Get System Stats & Device Distribution (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "stats"]
            }
          }
        }
      ]
    }
  ]
}
